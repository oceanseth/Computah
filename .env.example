# --- InsForge (backend) ---
# From your InsForge project at https://insforge.dev (or self-hosted http://localhost:7130)
INSFORGE_BASE_URL=https://your-project.us-east.insforge.app
INSFORGE_API_KEY=your_project_admin_api_key

# Storage bucket where step screenshots are saved (create it as a PUBLIC bucket)
INSFORGE_BUCKET=computah-shots

# AI models for browser-driving + verdict (comma-separated, first that works wins).
# The InsForge AI gateway is currently text-only, so Computah reasons over a text
# snapshot of the page. Cheap + reliable defaults below.
COMPUTAH_MODEL=openai/gpt-4o-mini,anthropic/claude-haiku-4.5

# --- Composio (messaging integrations) ---
# Connects source/destination messaging platforms (Discord, Slack, and Maskord
# once it lands on Composio) so people can drive the agents together.
# Get a key at https://app.composio.dev — ask the team for the shared project key.
COMPOSIO_API_KEY=your_composio_api_key

# --- MCP server only ---
# Base URL of the running Computah app the MCP tool should call.
COMPUTAH_URL=http://localhost:3000
