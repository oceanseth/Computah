# Always Listening Mobile — copy to .env and fill in (EXPO_PUBLIC_* is inlined into the bundle).
# Ask the team for the shared InsForge project values, or enter them in the app's Settings screen.
EXPO_PUBLIC_INSFORGE_URL=https://<appkey>.us-east.insforge.app
EXPO_PUBLIC_INSFORGE_KEY=ik_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_UNDERSTANDING_MODEL=openai/gpt-4o-mini

# Optional: bake the Deepgram key for live mic transcription (else enter it in Settings).
# EXPO_PUBLIC_DEEPGRAM_KEY=
